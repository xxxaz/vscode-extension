{
    "name": "task-supervisor-dashboard",
    "displayName": "Task Supervisor",
    "description": "監督台帳の依頼・タスク・通知を一覧表示し、行から完了・キック済み・回答を記録する",
    "version": "0.2.1",
    "publisher": "xxxaz",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/xxxaz/vscode-extension.git",
        "directory": "task-supervisor-dashboard"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false
        },
        "virtualWorkspaces": false
    },
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "xxxaz.task-supervisor.open",
                "title": "監督のダッシュボードを開く",
                "category": "Task Supervisor",
                "icon": "$(open-in-editor)"
            },
            {
                "command": "xxxaz.task-supervisor.refresh",
                "title": "一覧を更新する",
                "category": "Task Supervisor",
                "icon": "$(refresh)"
            },
            {
                "command": "xxxaz.task-supervisor.complete",
                "title": "依頼を完了にする（結果確認 OK）",
                "category": "Task Supervisor"
            },
            {
                "command": "xxxaz.task-supervisor.ran",
                "title": "依頼をキック済みにする",
                "category": "Task Supervisor"
            },
            {
                "command": "xxxaz.task-supervisor.answer",
                "title": "判断に回答する（推奨・自由記述）",
                "category": "Task Supervisor"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "xxxaz.task-supervisor.actions",
                    "name": "監督の一覧",
                    "type": "webview"
                }
            ]
        },
        "configuration": {
            "title": "Task Supervisor",
            "properties": {
                "taskSupervisor.runtimeCliPath": {
                    "type": "string",
                    "default": ".agents/skills/task-supervisor/runtime/cli.ts",
                    "scope": "machine",
                    "description": "常駐部の契約v1受付CLI。正本切替後にだけ使用します。"
                },
                "taskSupervisor.boardPath": {
                    "type": "string",
                    "default": ".claude/worktrees/supervisor-watch/.agents/skills/task-supervisor/board.ts",
                    "scope": "machine",
                    "description": "ワークスペースのルートからの信頼したboard.tsのパス。回答にはanswer-context/answer対応版が必要です。"
                },
                "taskSupervisor.nodePath": {
                    "type": "string",
                    "default": "/usr/local/bin/node",
                    "scope": "machine",
                    "description": "TypeScriptを直接実行できるNode 24以降のパス。ローカルで試す場合も設定できます。"
                }
            }
        },
        "menus": {
            "view/title": [
                {
                    "command": "xxxaz.task-supervisor.open",
                    "when": "view == xxxaz.task-supervisor.actions",
                    "group": "navigation@1"
                },
                {
                    "command": "xxxaz.task-supervisor.refresh",
                    "when": "view == xxxaz.task-supervisor.actions",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/run.ts",
        "prebuild": "npm run typecheck && npm test",
        "build": "node esbuild.config.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/bundle-smoke.ts",
        "package": "npm run build && vsce package --out dist/task-supervisor-dashboard.vsix",
        "preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/preview.ts",
        "test:board-parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/board-parity.ts"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^25.8.0",
        "@types/vscode": "~1.85.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.28.0",
        "jsdom": "^26.1.0",
        "typescript": "^6.0.3"
    },
    "activationEvents": [
        "onWebviewPanel:xxxaz.task-supervisor.dashboard"
    ]
}
